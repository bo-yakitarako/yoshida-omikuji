{
    "name": "yoshida",
    "version": "1.0.0",
    "description": "吉田は本来はyoshidaではなくkittaです",
    "main": "dist/index.js",
    "scripts": {
        "start": "bun ./dist/index.js",
        "dev": "bun --watch src/main.ts",
        "lint": "eslint --fix **/*.ts",
        "build-main": "bun build src/main.ts --target=node --minify --outfile=dist/index.js --external @napi-rs/canvas",
        "build-notice": "bun build src/notice.ts --target=node --minify --outfile=dist/notice.js --external @napi-rs/canvas",
        "build": "bun run build-main && bun run build-notice"
    },
    "author": "bo-yakitarako",
    "license": "MIT",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.33.0",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0"
    },
    "dependencies": {
        "@napi-rs/canvas": "^0.1.85",
        "dayjs": "^1.11.13",
        "discord.js": "^14.21.0",
        "mongodb": "^6.18.0"
    }
}
